<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>AudioControlWidget</AssemblyName>
    <RootNamespace>AudioCtl</RootNamespace>
    <Product>Audio Control Widget</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\BluetoothBatteryWidget\Native.cs" Link="Shared\Native.cs" />
    <Compile Include="..\BluetoothBatteryWidget\Credit.cs" Link="Shared\Credit.cs" />
    <Compile Include="..\BluetoothBatteryWidget\TaskbarZone.cs" Link="Shared\TaskbarZone.cs" />
    <Compile Include="..\BluetoothBatteryWidget\Theme.cs" Link="Shared\Theme.cs" />
    <Compile Include="..\BluetoothBatteryWidget\IconRenderer.cs" Link="Shared\IconRenderer.cs" />
    <Compile Include="..\BluetoothBatteryWidget\Models.cs" Link="Shared\Models.cs" />
    <Compile Include="..\BluetoothBatteryWidget\HoverCard.cs" Link="Shared\HoverCard.cs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

</Project>
